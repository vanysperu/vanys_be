# =====================================================================
# Variables de entorno del backend de Grulla.
#
# Desarrollo: copia este archivo como .env y completa los valores.
# Producción: NO uses este archivo. `npm run release` genera
# deploy/salida/variables-entorno.env con los secretos ya generados
# (ver deploy/GUIA-DESPLIEGUE-HOSTINGER.md).
# =====================================================================

# development | production. En production la app se niega a arrancar si
# falta alguna variable obligatoria (ver src/config/validateEnv.ts).
NODE_ENV=development

# Puerto. En el hosting se usa PORT (lo inyecta el propio hosting);
# PROY_APP_PORT queda para desarrollo.
PROY_APP_PORT=4750
# PORT=

# --- Base de datos (MySQL / MariaDB) --------------------------------
# En Hostinger el host para una app Node.js es 127.0.0.1 (NO "localhost").
PROY_BD_HOST=127.0.0.1
PROY_BD_PORT=3306
# Los scripts destructivos (db:reset-factory, db:seed-qa) solo corren si el
# nombre termina en _dev, _test, _qa o _local.
PROY_BD=grulla_dev
PROY_BD_USER=root
PROY_BD_PASS=

# Aplicar migraciones y seeders pendientes al arrancar el servidor (ver
# src/database/autoMigrate.ts). Por defecto: sí en production, no en
# development (ahí se usa sequelize-cli). true/false lo fuerza.
# DB_AUTO_MIGRATE=

# --- Seguridad ---------------------------------------------------------
# Clave con la que se firman las sesiones (JWT). En producción: mínimo 32
# caracteres y aleatoria (`npm run release` la genera).
SECRET_HIDDEN_KEY=

# Secreto del cron de vencimiento de cotizaciones (cabecera X-Cron-Secret).
# Vacío = endpoint deshabilitado.
CRON_SECRET=

# Orígenes permitidos por CORS en producción, separados por coma. Solo hace
# falta si el frontend se publica en OTRO dominio que la API.
CORS_ORIGINS=

# Cantidad de proxies delante de la app (para la IP real en los logs).
# TRUST_PROXY_HOPS=1

# --- Rutas (opcionales) ------------------------------------------------
# Carpeta con el build del frontend que sirve esta misma app. Por defecto:
# ./public (si existe un index.html adentro).
# FRONTEND_DIST_DIR=
# Carpeta de imágenes subidas ANTES de que se guardaran en la base (solo
# lectura, respaldo). Por defecto: ./uploads
# UPLOADS_DIR=

# --- Correo (Sprint 2) -------------------------------------------------
# Proveedor: brevo | log. Sin configurar: "log" en desarrollo (escribe en la
# consola) y ninguno en producción (los correos quedan fallidos y el admin
# copia el enlace para mandarlo por WhatsApp). Ver src/api/modules/email/README.md.
# EMAIL_PROVIDER=brevo
# BREVO_API_KEY=
# Remitente: un correo del dominio verificado en Brevo (SPF/DKIM/DMARC).
# EMAIL_FROM_ADDRESS=no-reply@tudominio.com
# EMAIL_FROM_NAME=Vanys
# Cupo diario del plan (Brevo gratis: 300). Al 80 % y al agotarse se avisa a
# los Super Administradores en la campana.
# EMAIL_DAILY_LIMIT=300

# Dirección pública de la app (la del frontend): con ella se arman los enlaces
# de los correos. Nunca se usa la cabecera Host. Obligatoria en producción para
# mandar enlaces. En desarrollo, por defecto http://localhost:4250.
# APP_PUBLIC_URL=https://tudominio.com

# Clave para cifrar datos sensibles en la base (cola de correos). Si no se
# define, se deriva de SECRET_HIDDEN_KEY. Si cambia, lo cifrado antes no se
# puede leer: en producción se conserva la primera.
# APP_ENCRYPTION_KEY=
